# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── GitHub ────────────────────────────────────────────────────────────────────
# Get from: github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=your-org-name

# ── Slack ─────────────────────────────────────────────────────────────────────
# Get from: api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_ALERT_CHANNEL=#hr-alerts

# ── Google Calendar ───────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs → Google Calendar API → Credentials
GOOGLE_CREDENTIALS_JSON=path/to/credentials.json




# ── Coral / Agent Settings ────────────────────────────────────────────────────
# Set to true to use mock data (no real API keys needed for hackathon)
USE_MOCK_DATA=true
MOCK_DATA_DIR=mock_data
CORAL_CACHE_TTL=300
ANALYSIS_WINDOW_DAYS=30
HIGH_RISK_THRESHOLD=70
MEDIUM_RISK_THRESHOLD=40
